# Env files: `.env` = local defaults, `.env.staging` = same vars with Neon
# values. Compose picks one via `--env-file`. Both are gitignored; only
# `.env.example` is committed.
#
# ---- Blog demo app ----
# Local host-dev default (localhost). Inside compose the blog service uses the
# postgres service DNS built from POSTGRES_* (see docker-compose.yml).
DATABASE_URL=postgres://blog:blog@localhost:5432/blog
BLOG_PORT=3000
SENTRY_DSN=

# ---- TrueForge harness ----
TRUEFORGE_BASE_URL=http://localhost:8790
TRUEFORGE_AGENT_NAME=three-am-investigator
# Harness DB (hosted mode): your Postgres. Standalone mode ignores this (SQLite).
TRUEFORGE_DATABASE_URL=
# Model FQN as configured in TrueForge UI (Settings → Models), e.g. anthropic/claude-sonnet-4-6
TRUEFORGE_MODEL=
# Model provider key is configured inside TrueForge UI (Settings → Models), not here.

# ---- TrueForge MCP connectors (creds live in connector, never in agent.json) ----
GRAFANA_MCP_URL=
GRAFANA_MCP_TOKEN=
SENTRY_MCP_URL=
SENTRY_MCP_TOKEN=

# ---- 3AM service ----
THREE_AM_PORT=3001
GRAFANA_BASE_URL=http://grafana:3000

# ---- Real comms (no mocks, no hardcoding — env only) ----
SLACK_BOT_TOKEN=
SLACK_CHANNEL_ID=
NOTION_TOKEN=
NOTION_DATABASE_ID=

# ---- Grafana Cloud (Alloy remote_write; Cloud is Cloud in every env) ----
GCLOUD_HOSTED_METRICS_ID=
GCLOUD_HOSTED_METRICS_URL=
GCLOUD_RW_API_KEY=

# ---- Upstash Redis (harness hosted-mode peering; Cloud is Cloud in every env) ----
REDIS_URL=

# ---- Grafana Cloud stack API (dashboards/alerts via API; gitignored) ----
GRAFANA_CLOUD_TOKEN=
GRAFANA_CLOUD_STACK=

# ---- Local Grafana (only used with --profile local-obs fallback) ----
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
PROMETHEUS_URL=http://prometheus:9090
